# ESPN Fantasy — no app registration needed. Connect via the in-app Connect
# screen instead: it collects your SWID/espn_s2 cookies plus league/team/season
# id and stores them in .tokens.json (gitignored). No env vars required here.

# Google Gemini — get a key at aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_SECRET=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_MAX_AGENT_ITERATIONS=10
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_MS=500

# Google Cloud / BigQuery
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=fantasy_engine

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production
